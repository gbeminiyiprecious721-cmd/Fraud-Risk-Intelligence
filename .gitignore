# Secrets / credentials / environment files -- none exist in this project as
# of Stage 7, but excluded defensively so one is never committed by accident.
.env
.env.*
*.pem
*.key
kaggle.json
credentials.json
secrets.json

# Large generated model artifacts / matrices. Stage 13 produced the first
# real one (artifacts/frozen_rf_fraud_risk_v1.joblib, ~16MB) -- excluded
# per the same "generated, not hand-authored" logic as the _stageN_*_raw.json
# evidence files above, and because 16MB is large enough that git would
# store it (and every future regenerated version) as a permanent binary
# blob. The artifact's SIDECAR MANIFEST (artifacts/*.manifest.json) is
# small, human-readable metadata and IS git-tracked -- it is the audit
# trail; `scripts/build_stage13_artifact.py` is the reproducible local
# command that regenerates the binary itself.
*.pkl
*.joblib
*.npy
*.npz
*.h5

# Stage 17 -- local deployment runtime state (pidfiles/logs) and disposable
# release candidates (e.g. the deliberately-corrupted Version B artifact
# copy used only for the rollback exercise). Never anything to track --
# regenerated fresh by deploy/start_release.sh / scripts/run_stage17_*.py.
deploy/run/
deploy/release_candidates/

# Stage 20 private training matrices, row-level outputs and challenger artifacts.
artifacts/stage20/
